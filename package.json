{
  "name": "nase-cms",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant Headless CMS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @nase-cms/backend",
    "dev:admin": "npm run dev -w @nase-cms/admin",
    "build": "npm run build -w @nase-cms/backend",
    "build:admin": "npm run build -w @nase-cms/admin",
    "start": "npm run start -w @nase-cms/backend",
    "typecheck": "npm run typecheck -w @nase-cms/backend"
  }
}
